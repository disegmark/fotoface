CLAUDE_API_KEY=tu-api-key-de-claude-aqui
PORT=3021

# Todas las claves de IA de aqui abajo (Claude, OpenAI/ChatGPT, DeepSeek,
# OpenRouter) tambien se pueden cargar y probar desde Dashboard -> Conexiones
# -> Claves de IA, sin reiniciar el servidor; lo guardado ahi tiene prioridad
# sobre estas variables, que quedan como respaldo/valor inicial.

# Login del dashboard (obligatorio): sin esto nadie puede iniciar sesion.
# Genera un JWT_SECRET largo y aleatorio, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ADMIN_EMAIL/ADMIN_PASSWORD solo se usan la PRIMERA vez que arranca el
# servidor (crean el primer usuario); despues se gestiona desde la DB.
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Recuperar contraseña por email (opcional; sin esto solo funciona la
# recuperacion por WhatsApp escribiendo "recuperar"). Usa Gmail con una
# "contraseña de aplicacion": generala en myaccount.google.com/apppasswords
# (requiere verificacion en 2 pasos activada en esa cuenta de Gmail).
EMAIL_USER=
EMAIL_APP_PASSWORD=

# Twilio (opcional, requerido para "tomar control humano" desde el dashboard):
# permite enviar mensajes de WhatsApp fuera del ciclo webhook/TwiML.
# Datos en https://console.twilio.com/ (Account Info) y tu numero de WhatsApp Sandbox/producción.
# Opcion A: Account SID + Auth Token (clasico)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Opcion B: API Key (recomendado por Twilio) — requiere tambien TWILIO_ACCOUNT_SID
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Llamadas salientes (opcional): confirmar turnos por telefono con voz.
# Requiere un numero de Twilio COMPRADO con capacidad de voz (el numero de
# WhatsApp Sandbox de arriba no sirve para esto).
TWILIO_VOICE_NUMBER=
# URL publica de este servidor (sin barra final), para que Twilio pueda
# llamar de vuelta al iniciar la llamada.
PUBLIC_BASE_URL=

# WhatsApp Cloud API de Meta (opcional): usar un numero ya aprobado
# directamente en Meta, sin pasar por Twilio. Canal independiente de Twilio y
# YCloud; se puede usar uno, otro, o varios en simultaneo. Tambien se puede
# cargar desde Dashboard -> Conexiones (META_APP_SECRET y META_VERIFY_TOKEN
# quedan solo por .env, son secretos de la app, no de la cuenta).
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=
META_APP_SECRET=

# YCloud (opcional): proveedor alternativo de WhatsApp Cloud API, con
# onboarding mas simple que Meta directo. Canal independiente de Meta y
# Twilio; se puede usar uno, otro, o varios en simultaneo. Tambien se puede
# cargar desde Dashboard -> Conexiones. API Key en app.ycloud.com (Settings >
# API Keys); configurar el webhook de YCloud apuntando a
# ${PUBLIC_BASE_URL}/api/webhook/ycloud con el evento
# whatsapp.inbound_message.received. YCLOUD_WEBHOOK_SECRET es opcional (sin
# el, no se valida la firma del webhook).
YCLOUD_API_KEY=
YCLOUD_WHATSAPP_NUMBER=
YCLOUD_WEBHOOK_SECRET=

# KPIs de publicidad (opcional, todas cargables tambien desde Dashboard ->
# Conexiones -> Claves de publicidad): Meta Ads, TikTok Ads, Google Ads,
# LinkedIn Ads y ChatGPT Ads. Variables correspondientes para cada una (ver
# server/services/clavesPublicidad.js):
#   META_ADS_ACCESS_TOKEN / META_ADS_ACCOUNT_ID
#   TIKTOK_ADS_ACCESS_TOKEN / TIKTOK_ADS_ADVERTISER_ID
#   GOOGLE_ADS_ACCESS_TOKEN / GOOGLE_ADS_CUSTOMER_ID / GOOGLE_ADS_DEVELOPER_TOKEN
#   LINKEDIN_ADS_ACCESS_TOKEN / LINKEDIN_ADS_ACCOUNT_ID
# ChatGPT Ads (ads.openai.com) no usa un ID de cuenta separado: la cuenta
# queda implicita en la propia API key.
CHATGPT_ADS_API_KEY=

# Integracion con Google Calendar (opcional)
# Poner en "true" para sincronizar los turnos con un Google Calendar real.
GOOGLE_CALENDAR_ENABLED=false
# ID del calendario a sincronizar (el email del calendario, o "primary").
GOOGLE_CALENDAR_ID=
# Credenciales de la cuenta de servicio de Google Cloud (IAM > Cuentas de servicio).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Google Meet real (opcional, requiere GOOGLE_CALENDAR_ENABLED=true arriba):
# permite que Nova genere un link de Meet de verdad al agendar un turno
# virtual. Como la cuenta de servicio de arriba NO puede crear espacios de
# Meet en cuentas de Gmail personales, hace falta un OAuth Client ID/Secret
# para que un usuario real autorice la conexion una sola vez desde el
# dashboard (pestaña Conexiones). Se crea en Google Cloud Console > APIs y
# servicios > Credenciales > Crear credenciales > ID de cliente de OAuth
# (tipo "Aplicacion web"), agregando como URI de redireccion autorizado:
#   ${PUBLIC_BASE_URL}/api/integraciones/google/callback
# Tambien hay que habilitar la "Google Meet API" en el proyecto y, como el
# proyecto va a quedar en modo "Prueba" (no verificado por Google), agregar tu
# propio email como "Usuario de prueba" en la pantalla de consentimiento
# OAuth. El refresh token que se obtiene se guarda en la base de datos, no aca.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ChatGPT/OpenAI (opcional): segundo nivel de la cadena de IA, resuelve las
# acciones (agendar/cancelar/reprogramar turnos, inscripciones) cuando DeepSeek
# escala. Consigue tu API key en https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# OpenRouter (opcional): ultimo respaldo si fallan los demas proveedores.
# Consigue tu API key en https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Modelo a usar en OpenRouter (ver catalogo en https://openrouter.ai/models)
OPENROUTER_MODEL=openai/gpt-4o-mini

# DeepSeek (opcional): primer nivel de atencion, economico. Resuelve preguntas
# generales, consultar disponibilidad y ver turnos/inscripciones existentes; si
# detecta que hay que ejecutar una accion o el caso es complejo, escala a
# ChatGPT o Claude (ver server/services/claude.js).
# Consigue tu API key en https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Chat web embebible (opcional): widget.js que se puede incluir en cualquier
# sitio con <script src="https://TU-DOMINIO/widget.js" defer></script>. Lista
# separada por comas de los origenes (dominios) autorizados a llamar a
# /api/webchat en produccion; vacio = se permite cualquier origen.
WEBCHAT_ALLOWED_ORIGINS=

# Seguimiento automatico (opcional): si un cliente deja a Nova sin respuesta,
# el sistema le manda un recordatorio a las 12, 24 y 48 horas. El de 12h es
# texto libre y funciona sin configuracion extra. Los de 24h/48h necesitan una
# plantilla (HSM) previamente aprobada en Meta Business Manager > WhatsApp
# Manager > Plantillas de mensajes (WhatsApp no permite texto libre pasadas
# las 24hs desde el ultimo mensaje del cliente). Pon aquí el "Nombre" exacto
# de cada plantilla aprobada; mientras esten vacias, esas dos etapas quedan
# pendientes (se loguea una advertencia, no se pierden, se mandan apenas se
# configure la plantilla).
WHATSAPP_TEMPLATE_SEGUIMIENTO_24H=
WHATSAPP_TEMPLATE_SEGUIMIENTO_48H=

# Apps integradas en Marketing/Oficina (opcional): entrada automatica (sin
# pedir clave) a las apps compartidas del VPS (carruseles, convertidor de
# video, quitar marca de agua, avatares en vivo, catalogos, slides, convertir
# documentos — ver client/src/lib/appsIntegradas.js). Cada app vive en su
# propio subdominio *.ia.nom.pe y requiere un secreto PROPIO (>= 32
# caracteres), coordinado con quien administra esa app (hay que registrar ahi
# un usuario "ia360" nuevo; no se reutilizan los secretos/usuarios de otros
# paneles como cg360). Sin el secreto de una app, su enlace simplemente abre
# esa app y pide su login normal — el resto del dashboard sigue funcionando.
SSO_SECRET_CARRUSELES=
SSO_SECRET_CONVERTIR_VIDEO=
SSO_SECRET_QUITAR_MARCA_AGUA=
SSO_SECRET_AVATARES=
SSO_SECRET_CATALOGOS=
SSO_SECRET_SLIDES=
SSO_SECRET_CONVERTIR_FORMATOS=

# Harness multi-agente (opcional): conecta Nova a agentes externos vía MCP
# (Model Context Protocol), locales (stdio) o remotos (http). Los servidores
# se definen en server/config/mcpServers.json (ver README).
MCP_ENABLED=false
MCP_CONFIG_PATH=server/config/mcpServers.json

# Canal alternativo via Evolution API + n8n (opcional): para un numero de
# WhatsApp operativo que NO corre campañas de Meta (no requiere Meta Cloud
# API). Un workflow en n8n recibe el webhook de Evolution API, lo normaliza a
# { telefono, mensaje, nombre } y llama a POST /api/webhook/evolution de este
# servidor con este secreto en el header "X-Webhook-Secret" (no hay firma
# criptografica en este canal, es la unica proteccion). Genera un valor largo
# y aleatorio, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sin esto, el endpoint responde 503 y rechaza cualquier llamada.
EVOLUTION_WEBHOOK_SECRET=

# --- FotoFace ---
PUBLIC_BASE_URL=https://fotoface.ia.nom.pe
# Origenes de la web publica que pueden enviar el formulario (POST /api/publico/pedido)
WEB_ORIGINS=https://fotoface.pro,https://www.fotoface.pro
# Repartos: clave de API de la cuenta "fotoface" (en repartos: API_KEY_FOTOFACE + API_KEY_FOTOFACE_CUENTA=fotoface)
REPARTOS_URL=https://repartos.ia.nom.pe
REPARTOS_API_KEY=
# Entrada automatica a Repartos (en repartos: SSO_FOTOFACE_SECRET + SSO_FOTOFACE_USUARIOS=fotoface)
SSO_SECRET_REPARTOS=

# Tarjetas digitales: cada tarjeta vive en <slug>.TARJETAS_DOMINIO
TARJETAS_DOMINIO=fotoface.pro
# Zona horaria de las fechas de los eventos (Lima)
TARJETAS_ZONA_OFFSET=-05:00
# Dominio del panel del proyecto Tarjetas (solo login y tarjetas)
TARJETAS_PANEL_HOST=tarjetas.fotoface.pro
