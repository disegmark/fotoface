{
  "name": "agente-ia-360",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de atencion al cliente por WhatsApp con IA para iA (ia.nom.pe), desplegado en 360.ia.nom.pe",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently \"node server/index.js\" \"cd client && npm run dev\"",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "setup": "npm install && cd client && npm install"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cookie": "0.7.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "googleapis": "^176.0.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.8.0",
    "nodemailer": "^9.0.6",
    "pdf-parse": "1.1.1",
    "socket.io": "^4.8.3",
    "twilio": "^5.3.5"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
